{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "fpe-design-system",
  "homepage": "https://github.com/ogfrench/fpe-design-system",
  "items": [
    {
      "name": "fpe-theme",
      "type": "registry:theme",
      "title": "FPE Hypermodern Theme",
      "description": "Apply neutral shadcn semantic color roles and FPE gradient brand tokens without changing Base UI or Radix primitives.",
      "cssVars": {
        "theme": {
          "font-sans": "\"IBM Plex Sans\", system-ui, sans-serif",
          "font-mono": "\"IBM Plex Mono\", monospace",
          "radius": "4px",
          "fpe-pink": "#F23D9F",
          "fpe-pink-deep": "#941F61",
          "fpe-violet": "#BA30F2",
          "fpe-pink-highlight": "#FF8FD3",
          "fpe-violet-bright": "#C34BE5",
          "fpe-pink-ink": "#AE1A73",
          "fpe-violet-ink": "#7421A0",
          "fpe-pink-stage": "#C32083",
          "fpe-violet-stage": "#2B0D42"
        },
        "light": {
          "background": "#FFFFFF",
          "foreground": "#000000",
          "card": "#FFFFFF",
          "card-foreground": "#000000",
          "popover": "#FFFFFF",
          "popover-foreground": "#000000",
          "primary": "#000000",
          "primary-foreground": "#FFFFFF",
          "secondary": "#000000",
          "secondary-foreground": "#FFFFFF",
          "muted": "#F5F5F5",
          "muted-foreground": "#555555",
          "accent": "#FCE8F3",
          "accent-foreground": "#000000",
          "destructive": "#B42331",
          "destructive-foreground": "#FFFFFF",
          "border": "#DEDEDE",
          "input": "#DEDEDE",
          "ring": "#000000",
          "chart-1": "#941F61",
          "chart-2": "#000000",
          "chart-3": "#BA30F2",
          "chart-4": "#8A5305",
          "chart-5": "#777777",
          "sidebar": "#FFFFFF",
          "sidebar-foreground": "#000000",
          "sidebar-primary": "#000000",
          "sidebar-primary-foreground": "#FFFFFF",
          "sidebar-accent": "#FCE8F3",
          "sidebar-accent-foreground": "#000000",
          "sidebar-border": "#DEDEDE",
          "sidebar-ring": "#000000"
        },
        "dark": {
          "background": "#000000",
          "foreground": "#FFFFFF",
          "card": "#080808",
          "card-foreground": "#FFFFFF",
          "popover": "#080808",
          "popover-foreground": "#FFFFFF",
          "primary": "#FFFFFF",
          "primary-foreground": "#000000",
          "secondary": "#FFFFFF",
          "secondary-foreground": "#000000",
          "muted": "#171717",
          "muted-foreground": "#BDBDBD",
          "accent": "#171717",
          "accent-foreground": "#FFFFFF",
          "destructive": "#FC6975",
          "destructive-foreground": "#000000",
          "border": "#292929",
          "input": "#292929",
          "ring": "#FFFFFF",
          "chart-1": "#C34BE5",
          "chart-2": "#FFFFFF",
          "chart-3": "#BA30F2",
          "chart-4": "#941F61",
          "chart-5": "#FFFFFF",
          "sidebar": "#080808",
          "sidebar-foreground": "#FFFFFF",
          "sidebar-primary": "#FFFFFF",
          "sidebar-primary-foreground": "#000000",
          "sidebar-accent": "#171717",
          "sidebar-accent-foreground": "#FFFFFF",
          "sidebar-border": "#292929",
          "sidebar-ring": "#FFFFFF"
        }
      },
      "css": {
        "@layer base": {
          ":root": {
            "--fpe-gradient-brand": "linear-gradient(112deg, #FF8FD3 0%, #F23D9F 46%, #C34BE5 100%)",
            "--fpe-gradient-brand-hover": "linear-gradient(112deg, #FF8FD3 0%, #F55AB0 48%, #D45EEA 100%)",
            "--fpe-gradient-hero": "linear-gradient(137deg, #C32083 0%, #941F61 52%, #2B0D42 100%)",
            "--fpe-gradient-ink-light": "linear-gradient(112deg, #AE1A73 0%, #7421A0 100%)",
            "--fpe-gradient-ink-dark": "linear-gradient(112deg, #FF8FD3 0%, #F23D9F 46%, #C34BE5 100%)",
            "--fpe-gradient-hairline": "linear-gradient(90deg, transparent 0%, #F23D9F 36%, #C34BE5 72%, transparent 100%)",
            "--fpe-gradient-text": "var(--fpe-gradient-ink-light)"
          },
          ".dark": {
            "--fpe-gradient-text": "var(--fpe-gradient-ink-dark)"
          }
        }
      }
    },
    {
      "name": "fpe-logo",
      "type": "registry:ui",
      "title": "FPE Logo",
      "description": "Responsive inline SVG FPE monogram in pink, white or black. FPE brand usage restrictions apply.",
      "files": [
        {
          "path": "registry/fpe-logo.tsx",
          "type": "registry:ui",
          "target": "@ui/fpe-logo.tsx"
        }
      ]
    },
    {
      "name": "fpe-hero",
      "type": "registry:block",
      "title": "FPE Hero",
      "description": "Brand marketing hero with responsive typography, expressive color and a semantic link.",
      "registryDependencies": [
        "ogfrench/fpe-design-system/fpe-logo"
      ],
      "files": [
        {
          "path": "registry/fpe-hero.tsx",
          "type": "registry:component",
          "target": "@components/fpe-hero.tsx"
        }
      ]
    }
  ]
}
